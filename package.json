{
  "name": "sketchclone",
  "version": "2.2.0",
  "description": "Aplikasi desktop pemodelan 3D ala SketchUp",
  "main": "main.cjs",
  "scripts": {
    "build:js": "esbuild app.js --bundle --format=esm --outfile=bundle/app.js --sourcemap --log-level=warning",
    "start": "npm run build:js && electron .",
    "dist": "npm run build:js && electron-builder --win",
    "release": "npm run build:js && electron-builder --win --publish always",
    "release:publish": "node -e \"const v=require('./package.json').version;require('child_process').execSync('gh release edit v'+v+' --draft=false',{stdio:'inherit'})\""
  },
  "author": "SketchClone",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "fflate": "^0.8.3",
    "opentype.js": "^2.0.0",
    "qrcode": "^1.5.4",
    "three": "^0.186.1",
    "three-bvh-csg": "^0.0.18",
    "three-mesh-bvh": "^0.9.16"
  },
  "build": {
    "appId": "com.sketchclone.app",
    "productName": "SketchClone",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "index.html",
      "style.css",
      "bundle/**",
      "build/icon.png"
    ],
    "extraResources": [
      {
        "from": "spongebob.skc",
        "to": "contoh/spongebob.skc"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "icon": "build/icon.png",
    "publish": [
      {
        "provider": "github",
        "owner": "firestarr",
        "repo": "sketchclone",
        "releaseType": "draft"
      }
    ],
    "artifactName": "${productName}-${version}.${ext}",
    "portable": {
      "artifactName": "${productName}-${version}.${ext}"
    }
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "electron-updater": "^6.8.9"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/firestarr/sketchclone.git"
  }
}
